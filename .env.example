# Keep this value for the required production address.
NEXT_PUBLIC_BASE_PATH=/academy

# Configure either or both supported AI provider keys.
# Never expose these through variables beginning with NEXT_PUBLIC_.
GROQ_API_KEY=
GEMINI_API_KEY=

# Supabase Configuration (Free Tier, Step 2)
# Public project URL and Anonymous Key for client authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Service Role Key (Privileged, never expose to client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
